@startuml SIS_DB_ERD
' layout
left to right direction
skinparam linetype ortho
skinparam shadowing false

' --- tables ---
entity "organizations" as org {
  * organization_id : NVARCHAR(36) <<PK>>
  --
    name : NVARCHAR(200) NOT NULL
    address : NVARCHAR(500)
    city : NVARCHAR(100)
    url : NVARCHAR(500)
    phone : NVARCHAR(50)
    email : NVARCHAR(200)
}

entity "contact_persons" as cp {
  * id : NVARCHAR(36) <<PK>>
  --
    organization_id : NVARCHAR(36) <<FK>>
    first_name : NVARCHAR(100)
    last_name : NVARCHAR(100)
    email : NVARCHAR(200)
    job_title : NVARCHAR(200)
    phone : NVARCHAR(50)
    department : NVARCHAR(200)
}

entity "internships" as intern {
  * id : NVARCHAR(36) <<PK>>
  --
    organization_id : NVARCHAR(36) <<FK>>
    title : NVARCHAR(500)
    short_description : NVARCHAR(MAX)
    long_description : NVARCHAR(MAX)
    year : INT
    semester : INT
    category : INT
    is_completed : BIT
    final_grade : FLOAT
}

entity "internship_contacts" as ic {
  * internship_id : NVARCHAR(36) <<PK,FK>>
  * contact_id : NVARCHAR(36) <<PK,FK>>
}

entity "students" as s {
  * student_id : NVARCHAR(50) <<PK>>
  --
    first_name : NVARCHAR(200)
    last_name : NVARCHAR(200)
}

entity "internship_assignments" as ia {
  * internship_id : NVARCHAR(36) <<PK,FK>>
  * student_id : NVARCHAR(50) <<PK,FK>>
}

' --- relationships / cardinality ---
org ||--o{ cp : "1 - 0..* (employs)"
org ||--o{ intern : "1 - 0..* (offers)"

intern ||--o{ ic : "1 - 0..* (has contact links)"
cp   ||--o{ ic : "1 - 0..* (linked to internships)"

intern ||--o{ ia : "1 - 0..* (has assignments)"
s    ||--o{ ia : "1 - 0..* (assignments)"

' --- foreign key / cascade notes ---
note right of cp
  FK contact_persons.organization_id -> organizations.organization_id
  ON DELETE CASCADE
end note

note right of intern
  FK internships.organization_id -> organizations.organization_id
  ON DELETE CASCADE
end note

note right of ic
  FK internship_contacts.internship_id -> internships.id   ON DELETE NO ACTION
  FK internship_contacts.contact_id    -> contact_persons.id ON DELETE NO ACTION
  (NO CASCADE to avoid multiple cascade paths)
end note

note right of ia
  FK internship_assignments.internship_id -> internships.id ON DELETE CASCADE
  FK internship_assignments.student_id    -> students.student_id ON DELETE CASCADE
end note

@enduml