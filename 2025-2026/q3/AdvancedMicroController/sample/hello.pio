.pio_version 0 // only requires PIO version 0

.program hello

; Use side-set for the clock (1 bit).
; Mapping:
;  - OUT pin: Data
;  - SET pin: Latch
;  - SIDESET pin: Clock

.side_set 1 opt

loop:
    pull             side 0 ; Pull 32 bits from FIFO to OSR
    set x, 7         side 0 ; Initialize bit counter to 7 (8 bits)
    
bitloop:
    out pins, 1      side 0 [5]; Shift 1 bit to OUT pin, Clock Low
    jmp x-- bitloop  side 1 ; Jump back if x!=0, Clock High (Data is sampled on rising edge usually, or falling?)
                            ; In C code: Data set, wait, Clock High, wait, Clock Low.
                            ; Here: Data set (side 0), then side 1 (Clock High).
                            ; We need to ensure timing.
    
    ; After 8 bits, pulse latch
    set pins, 1      side 0 ; Latch High, Clock Low
    set pins, 0      side 0 ; Latch Low
    jmp loop         side 0 ; Repeat

% c-sdk {
static inline void hello_program_init(PIO pio, uint sm, uint offset, uint data_pin, uint clock_pin, uint latch_pin) {
    pio_sm_config c = hello_program_get_default_config(offset);

    // Map the state machine's OUT pin group to one pin, namely the `data_pin`
    sm_config_set_out_pins(&c, data_pin, 1);
    
    // Map the SET pin group to the `latch_pin`
    sm_config_set_set_pins(&c, latch_pin, 2);
    
    // Map the SIDESET pin group to the `clock_pin`
    sm_config_set_sideset_pins(&c, clock_pin);

    // Set pin directions
    pio_gpio_init(pio, data_pin);
    pio_gpio_init(pio, clock_pin);
    pio_gpio_init(pio, latch_pin);
    
    // Set all three pins to output
    pio_sm_set_consecutive_pindirs(pio, sm, data_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, clock_pin, 1, true);
    pio_sm_set_consecutive_pindirs(pio, sm, latch_pin, 1, true);

    // Load our configuration, and jump to the start of the program
    pio_sm_init(pio, sm, offset, &c);
    // Set the state machine running
    pio_sm_set_enabled(pio, sm, true);
}
%}
